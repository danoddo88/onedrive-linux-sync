#!/bin/bash
# =============================================================================
#  "Mantener siempre en esta PC"  --  copia local real, en los dos sentidos
#
#  Baja la carpeta entera a ~/.onedrive-local/<carpeta>. Son archivos de
#  verdad en el disco: se leen al instante, sin esperar a internet.
#
#  La sincronizacion es BIDIRECCIONAL y automatica cada 5 minutos:
#    - lo que cambies en esta PC sube a la nube
#    - lo que cambies en otro dispositivo baja a esta PC
#  Si un archivo cambio en los dos lados, gana el mas reciente.
#
#  Uso:
#    onedrive-local --fijar   ~/OneDrive/carpeta
#    onedrive-local --soltar  ~/OneDrive/carpeta
#    onedrive-local --ahora   [carpeta]
#    onedrive-local --lista
# =============================================================================
set -u
RAIZ="$HOME/OneDrive"
LOCAL="$HOME/.onedrive-local"
CONF="$HOME/.config/onedrive-sync"
FIJADAS="$CONF/fijadas.conf"
REGISTRO="$CONF/historial-local.log"
mkdir -p "$CONF" "$LOCAL"; touch "$FIJADAS"

grafico() { [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null; }
aviso()   { grafico && notify-send -i folder-download "OneDrive" "$1" 2>/dev/null; echo "$1"; }
error()   { grafico && zenity --error --width=440 --text="$1" 2>/dev/null; echo "ERROR: $1" >&2; exit 1; }
anotar()  { echo "$(date "+%F %T")  $*" >> "$REGISTRO"; }

OPC="--transfers 8 --checkers 8 --conflict-resolve newer --resilient --recover
     --create-empty-src-dirs --exclude .Trash-*/** --exclude *.tmp
     --log-file $REGISTRO --log-level INFO"

# Bandera que le dice a la cola rapida que se quede quieta mientras
# comparamos. Sin esto, la cola volveria a subir todo lo que acabamos de bajar.
BANDERA="${XDG_RUNTIME_DIR:-/tmp}/onedrive-revision-en-curso"
# Una bandera POR CARPETA: mientras se revisa micro1, el lector y la cola
# siguen atendiendo las demas carpetas (antes una sola bandera frenaba todo
# durante los 20-30 min que tarda cada revision grande).
bandera_poner()  { mkdir -p "$BANDERA"; printf "%s" "$1" > "$BANDERA/$(printf "%s" "$1" | md5sum | cut -c1-32)"; }
bandera_quitar() { rm -f "$BANDERA/$(printf "%s" "$1" | md5sum | cut -c1-32)"; rmdir "$BANDERA" 2>/dev/null; return 0; }
# Salvaguarda de borrados masivos (la misma que OneDrive de Microsoft): si una
# pasada va a borrar MAXBORRAR archivos o mas, se frena y se pregunta.
MAXBORRAR="${ONEDRIVE_MAX_BORRAR:-200}"
PENDIENTES="$CONF/borrados-pendientes"

# Pregunta "borrar / restaurar / despues" en la pantalla :0 aunque nos hayan
# lanzado sin DISPLAY (systemd, cron). Devuelve: borrar | restaurar | despues
preguntar_borrado() {
    local TXT="$1" R
    export DISPLAY="${DISPLAY:-:0}"
    if ! xset q >/dev/null 2>&1 || ! command -v zenity >/dev/null; then echo despues; return; fi
    R=$(zenity --question --width=520 --title="OneDrive: se borraron muchos archivos" \
          --text="$TXT" --ok-label="Borrarlos también acá" \
          --cancel-label="Restaurarlos en la nube" --extra-button="Decidir después" 2>/dev/null)
    case "$?:$R" in
        0:*) echo borrar ;;
        1:"Decidir después") echo despues ;;
        1:*) echo restaurar ;;
        *) echo despues ;;
    esac
}
tiene_pendientes() { [ -e "$PENDIENTES/$(printf "%s" "$1" | md5sum | cut -c1-32).json" ]; }

sincronizar() {
    local L="$1" R="$2" EXTRA="${3:-}" RES=0
    if tiene_pendientes "$R"; then
        anotar "SALTEADA $R: hay un borrado masivo esperando tu decision"
        /usr/local/bin/onedrive-borrados --preguntar >/dev/null 2>&1 &
        return 0
    fi
    bandera_poner "$R"
    rclone bisync "$L" "onedrive:$R" $OPC $EXTRA || RES=$?
    # bisync se niega a borrar mas de la mitad de un lado ("Safety abort: too
    # many deletes"). Es la misma situacion que la pregunta de Microsoft:
    # borrar tambien del otro lado, o restaurar lo que falta.
    if [ "$RES" -ne 0 ] && tail -40 "$REGISTRO" 2>/dev/null | grep -q "Safety abort: too many deletes"; then
        anotar "FRENADA $R: demasiados borrados de un lado; pregunto"
        case "$(preguntar_borrado "En «$R» desaparecio mas de la mitad de los archivos\nde un lado (esta PC o la nube).\n\n¿Que hago con el otro lado?")" in
            borrar)    anotar "DECISION borrar en $R"; RES=0
                       rclone bisync "$L" "onedrive:$R" $OPC $EXTRA --force || RES=$? ;;
            restaurar) anotar "DECISION restaurar en $R"; RES=0
                       rclone bisync "$L" "onedrive:$R" $OPC --resync --resync-mode newer || RES=$? ;;
            *)         anotar "DECISION postergada en $R" ;;
        esac
    fi
    # Si una corrida anterior aborto (por ejemplo, sin internet), bisync pierde
    # sus listas y se niega a seguir hasta una resincronizacion. La hacemos
    # solos, con la regla de que gana el archivo mas nuevo de cada lado, asi
    # no se pisa nada que se haya editado desde otro dispositivo durante el corte.
    # Dos revisiones a la vez no pueden correr: bisync deja un bloqueo. Si
    # chocamos con una en curso, no es un fallo: la otra esta haciendo el trabajo.
    if [ "$RES" -ne 0 ] && tail -15 "$REGISTRO" 2>/dev/null | grep -q "prior lock file found"; then
        anotar "SALTEADA $R: ya hay otra revision en curso"
        sleep 2; bandera_quitar "$R"; return 0
    fi
    if [ "$RES" -ne 0 ] && [ -z "$EXTRA" ] && tail -40 "$REGISTRO" 2>/dev/null | grep -qE "cannot find prior Path1 or Path2 listings|Must run --resync to recover"; then
        anotar "RECUPERANDO $R: resincronizacion (gana el mas nuevo)"
        RES=0
        rclone bisync "$L" "onedrive:$R" $OPC --resync --resync-mode newer || RES=$?
        [ "$RES" -eq 0 ] && anotar "RECUPERADA $R" || anotar "NO SE PUDO RECUPERAR $R"
    fi
    # Margen de 2 segundos: los avisos del nucleo llegan con retraso y sin
    # esta pausa la cola alcanzaria a ver los archivos recien bajados.
    sleep 2
    bandera_quitar "$R"
    # (las marcas las mantiene onedrive-marcas-vivas, en la carpeta que miras)
    return $RES
}

case "${1:-}" in
  --fijar)
    C="$(realpath "${2:?falta la carpeta}")"
    [ -d "$C" ] || error "Eso no es una carpeta."
    case "$C/" in
      "$RAIZ/"*) : ;;
      *) error "Esta opción es para carpetas de dentro de ~/OneDrive.\n\nPara SUBIR una carpeta propia a la nube, usá\n«Mantener sincronizada con OneDrive»." ;;
    esac
    RUTA="${C#$RAIZ/}"
    DESTINO="$LOCAL/$RUTA"
    grep -qxF "$RUTA" "$FIJADAS" && error "«$(basename "$C")» ya está guardada en esta PC:\n\n$DESTINO"

    # Medir una carpeta grande puede tardar minutos. Avisar enseguida, y no
    # esperar mas de 45 s: sin esto, parecia que la opcion no habia hecho nada.
    aviso "Calculando el tamaño de «$(basename "$C")»... (puede tardar hasta un minuto)"
    TAM=$(timeout 45 rclone size "onedrive:$RUTA" --json 2>/dev/null | python3 -c "import json,sys
try:
    d=json.load(sys.stdin); print(\"%.1f GB en %d archivos\" % (d[\"bytes\"]/1e9, d[\"count\"]))
except Exception: print(\"muy grande para medirla rápido (más de 45 s)\")" 2>/dev/null)
    LIBRE=$(df -BG --output=avail / | tail -1 | tr -d " G")

    if grafico; then
        zenity --question --width=480 \
          --title="Mantener siempre en esta PC" \
          --text="«$(basename "$C")» se descargará entera y quedará en:\n\n   $DESTINO\n\nTamaño: $TAM\nLibre en disco: ${LIBRE} GB\n\nDesde entonces se sincroniza sola cada 5 minutos, en\nlos DOS sentidos: lo que cambies acá sube, y lo que\ncambies en otro dispositivo baja.\n\n¿Descargar ahora?" || exit 0
    fi

    mkdir -p "$DESTINO"
    # Flechas de sincronizacion mientras baja, como en Windows
    gio set -t stringv "$C" metadata::emblems emblem-synchronizing 2>/dev/null
    # anotarla como "en curso": las marcas en vivo le ponen flechas a todo su contenido
    echo "$RUTA" >> "$CONF/en-curso.conf"
    # De a una carpeta por vez y con pocas conexiones: con varias descargas
    # grandes a la vez la linea se satura y abrir cualquier carpeta de
    # ~/OneDrive tardaba minutos (3 carpetas x 16 = 48 conexiones).
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/onedrive-fijar.lock"
    if ! flock -n 9; then
        aviso "«$(basename "$C")» queda en espera: hay otra carpeta bajando. Empieza sola cuando termine."
        anotar "EN ESPERA $RUTA (otra carpeta bajando)"
        flock 9
    fi
    # Muchos hilos: con archivos chicos el limite es la espera de cada pedido,
    # no la linea. Microsoft frena si se abusa; rclone espera y sigue solo.
    # Se ajusta con la variable ONEDRIVE_HILOS (ver README).
    HILOS="${ONEDRIVE_HILOS:-16}"
    OPC="${OPC/--transfers 8 --checkers 8/--transfers $HILOS --checkers $HILOS}"
    anotar "FIJANDO $RUTA -> $DESTINO ($TAM)"
    aviso "Descargando «$(basename "$C")»... ($TAM)"
    # Paso 1: dejar la copia de la PC igual a la nube. Compara carpeta por
    # carpeta y baja lo que falta mientras sigue comparando (bisync, en cambio,
    # lista todo antes de bajar nada). Nunca sube ni borra en la nube.
    # Si se corta, al retomarlo saltea lo que ya esta y sigue.
    # SALVAGUARDA: es "sync", no "copy". Lo que esta en la PC y ya no esta en
    # la nube (por ejemplo, borrado desde otro dispositivo mientras bajaba) se
    # BORRA de la PC: si se quedara, el paso 2 lo volveria a subir y
    # reapareceria. Lo borrado en la nube sigue en la papelera de OneDrive.
    # --update: lo que la PC tiene mas nuevo que la nube no se pisa; sube en
    # el paso 2, porque es un cambio de verdad.
    # --tpslimit: tope de pedidos por segundo, para quedar debajo del cupo de
    # Microsoft. Pasarse frena TODAS las descargas por minutos.
    TPS="${ONEDRIVE_TPS:-12}"
    bandera_poner "$RUTA"
    # --max-delete + --delete-after: primero baja todo; si al final tendria que
    # borrar MAXBORRAR archivos o mas de esta PC, no borra y pregunta (abajo).
    OPC1="--update --transfers $HILOS --checkers $HILOS --tpslimit $TPS --tpslimit-burst $TPS
          --create-empty-src-dirs --log-file $REGISTRO --log-level INFO --stats 1m"
    EXC=(--exclude ".Trash-*/**" --exclude "*.tmp")
    rclone sync "onedrive:$RUTA" "$DESTINO" $OPC1 "${EXC[@]}" --delete-after --max-delete "$MAXBORRAR"
    R1=$?
    if [ "$R1" -ne 0 ] && tail -30 "$REGISTRO" 2>/dev/null | grep -q -- "--max-delete threshold reached"; then
        anotar "FRENADA $RUTA: la nube tiene $MAXBORRAR archivos menos (o mas) que esta PC; pregunto"
        case "$(preguntar_borrado "En la nube ya no estan al menos $MAXBORRAR archivos que esta PC\ntiene en «$(basename "$C")» (los borraron desde otro dispositivo).\n\n¿Que hago con la copia de esta PC?")" in
            borrar)    anotar "DECISION borrar en $RUTA"
                       rclone sync "onedrive:$RUTA" "$DESTINO" $OPC1 "${EXC[@]}" --delete-after; R1=$? ;;
            restaurar) anotar "DECISION restaurar en $RUTA (los sube el paso 2)"; R1=0 ;;
            *)         anotar "DECISION postergada en $RUTA: queda sin terminar; se vuelve a preguntar al retomar"
                       bandera_quitar "$RUTA"; exec 9>&-; exit 3 ;;
        esac
    fi
    anotar "COPIA INICIAL TERMINADA $RUTA (codigo $R1); armando la sincronizacion"
    # Paso 2: bisync una vez, para que quede en los dos sentidos. Ya esta todo
    # bajado, asi que solo compara.
    # --resync-mode newer: en una resincronizacion rclone hace ganar a la copia
    # LOCAL por defecto. Si otro dispositivo cambio un archivo entre la descarga
    # y este paso, la copia vieja de aca pisaria la nueva. Con "newer" gana el
    # mas reciente.
    sincronizar "$DESTINO" "$RUTA" "--resync --resync-mode newer"; OKF=$?
    exec 9>&-
    grep -vxF "$RUTA" "$CONF/en-curso.conf" > "$CONF/en-curso.tmp" 2>/dev/null || true
    mv "$CONF/en-curso.tmp" "$CONF/en-curso.conf"
    if [ "$OKF" -eq 0 ]; then
        echo "$RUTA" >> "$FIJADAS"
        N=$(find "$DESTINO" -type f 2>/dev/null | wc -l)
        anotar "OK $RUTA ($N archivos)"
        sudo /usr/local/sbin/onedrive-bind montar "$RUTA"
        /usr/local/bin/onedrive-tildes --aplicar >/dev/null 2>&1 &
        aviso "«$(basename "$C")» lista: $N archivos, ya en esta PC"
        systemctl --user start onedrive-local.timer 2>/dev/null
    else
        anotar "FALLO al fijar $RUTA"
        gio set -t stringv "$C" metadata::emblems emblem-web 2>/dev/null
        error "No se pudo descargar.\n\nDetalle en: $REGISTRO"
    fi
    ;;

  --soltar)
    C="${2:?falta la carpeta}"
    RUTA="${C#$RAIZ/}"; RUTA="${RUTA#$LOCAL/}"; RUTA="${RUTA%/}"
    grep -qxF "$RUTA" "$FIJADAS" || error "Esa carpeta no estaba guardada en esta PC."
    if grafico; then
        zenity --question --width=470 --title="Dejar de guardar en esta PC" \
          --text="«$(basename "$C")» deja de sincronizarse.\n\nVuelve a verse solo desde la nube (se descarga al abrir).\n\nNada se borra en OneDrive. La copia local queda en\n~/.onedrive-local por si querés recuperarla." || exit 0
    fi
    sudo /usr/local/sbin/onedrive-bind desmontar "$RUTA"
    grep -vxF "$RUTA" "$FIJADAS" > "$FIJADAS.tmp" || true
    mv "$FIJADAS.tmp" "$FIJADAS"
    anotar "SOLTADA $RUTA"
    aviso "«$(basename "$C")» ya no se sincroniza."
    ;;

  --ahora)
    if [ -n "${2:-}" ]; then
        C="$2"; RUTA="${C#$RAIZ/}"; RUTA="${RUTA#$LOCAL/}"; RUTA="${RUTA%/}"
        grep -qxF "$RUTA" "$FIJADAS" || error "Esa carpeta no está marcada."
        aviso "Sincronizando «$(basename "$C")»..."
        sincronizar "$LOCAL/$RUTA" "$RUTA" && aviso "«$(basename "$C")» al día."
    else
        while IFS= read -r R; do
            [ -n "$R" ] || continue
            sincronizar "$LOCAL/$R" "$R" || anotar "FALLO en $R"
        done < "$FIJADAS"
    fi
    ;;

  --lista)
    [ -s "$FIJADAS" ] || { echo "Ninguna carpeta guardada en esta PC."; exit 0; }
    printf "%-38s %10s  %s\n" "CARPETA" "ARCHIVOS" "COPIA LOCAL"
    while IFS= read -r R; do
        [ -n "$R" ] || continue
        printf "%-38s %10s  %s\n" "$R" "$(find "$LOCAL/$R" -type f 2>/dev/null | wc -l)" "$LOCAL/$R"
    done < "$FIJADAS"
    echo; echo "Ocupan: $(du -sh "$LOCAL" 2>/dev/null | cut -f1)"
    ;;

  *) sed -n "2,16p" "$0" | sed "s/^# \{0,2\}//" ;;
esac
